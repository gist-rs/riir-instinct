# riir-instinct local configuration — the template for `.env`.
#
# Copy:  cp .env.example .env   then fill in values.
# NEVER commit `.env`. ⚠ This repo's .gitignore does NOT list `.env` yet —
# add it before creating one.
#
# This repo reads NO secrets and has no deploy credentials (the hosted
# deployment lives in riir-rethink). Every variable below is an OPTIONAL
# override; nothing sources `.env` automatically — export what you need.

# ── `serve` binary (src/bin/serve.rs, src/serve_edge.rs) ───────────────────
# INSTINCT_DATASETS_DIR: dataset suites dir. Default ../riir-reflex/.raw/datasets_t20k
# INSTINCT_WINNERS_DIR: specialist winners dir. Default artifacts/cache
#   (filled by scripts/fetch_artifacts.sh).
# INSTINCT_BIND: listen address. Default 0.0.0.0:8080.
# INSTINCT_ARSENAL: arsenal manifest path (or --arsenal); absent = embedded default.
# INSTINCT_SYNTH_CORPUS_DIR: set → suites with <dir>/<suite>_synth.jsonl seat it;
#   unset = the gold corpus everywhere.
# RIIR_INSTINCT_ALLOWED_ORIGIN: comma-separated CORS allow-list. Default empty
#   (no cross-origin access).
# INSTINCT_LRU_CAPACITY: per-domain resident-lane LRU budget. 0/unset = OFF.
# RIIR_INSTINCT_HOARD_GATE=0: disarms the hoarding gate (exact literal `0`;
#   anything else, including unset, leaves it armed).
# INSTINCT_DATASETS_DIR=../riir-reflex/.raw/datasets_t20k
# INSTINCT_WINNERS_DIR=artifacts/cache
# INSTINCT_BIND=0.0.0.0:8080
# INSTINCT_ARSENAL=
# INSTINCT_SYNTH_CORPUS_DIR=
# RIIR_INSTINCT_ALLOWED_ORIGIN=
# INSTINCT_LRU_CAPACITY=0
# RIIR_INSTINCT_HOARD_GATE=0

# ── Script / example / test knobs (not runtime config) ─────────────────────
# CHECK=1                scripts/fetch_artifacts.sh — verify cached bytes only, no network
# ALLOWLIST_OVERRIDE     scripts/fence_gate.sh — alternate allowlist file
# HEAL_HEAD_PATH         examples/heal_specialist_server.rs (required by that example)
# HEAL_DEBUG             examples/instinct_heal_train.rs
# TETRIS_LANE_FIXTURE_DIR, TET_CRITIC_MODEL, TET_CRITIC_PARITY,
# TET_CRITIC_PARITY_REQUIRE, INSTINCT_ENCODER_PARITY — benches/tests
