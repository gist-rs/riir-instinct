/target
.DS_Store
CLAUDE.md
.raw/
# Specialist weights and HOSTED-ONLY vessels are runtime data — never committed
# (riir-clippy Proposal 009: weights are bytes, never a path dep).
*.vessel
*.bin
*.safetensors
*.gguf

# The artifact lane (instinct issue 020 / Plan 623 T4): payloads are
# runtime data, gitignored BY DIRECTORY — artifacts/manifest.toml is the
# only tracked file (the workspace artifact-boundary law:
# artifacts/<kind>/<class>/ canonical placement + cache/ pulls).
artifacts/**
!artifacts/manifest.toml
# The L1 training lane's output (Plan 008 B4): the teaching recipes'
# freshly-trained winner candidates + seals — runtime data, never
# committed (the *.bin/*.vessel rules already refuse the artifacts; this
# keeps the empty-dir noise out too).
/data/trained_specialists/

# riir-deploy build/stage trees (generated; the manifest is the source of truth)
/.deploy/
/dist/

# cargo-refine machine-local state (trajectories, fixseq, outbox, active-set)
.refine/
.export/
__pycache__/
